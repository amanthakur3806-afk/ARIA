# .env.example — placeholders only.
# Copy this file to .env and fill in your own values.
# NEVER commit .env to the repository.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Runtime connection — uses arya_app (limited privileges, cannot DROP tables)
DATABASE_URL=postgresql+psycopg://arya_app:<password>@<host>:5432/arya_dev?sslmode=require

# Migration connection — uses arya_migrator (can CREATE / ALTER / DROP)
# Use the direct (non-pooled) connection string from your service dashboard.
MIGRATION_DATABASE_URL=postgresql+psycopg://arya_migrator:<password>@<host>:5432/arya_dev?sslmode=require

# Test database — wipes tables freely, never touches arya_dev data
TEST_DATABASE_URL=postgresql+psycopg://arya_migrator:<password>@<host>:5432/arya_test?sslmode=require

# ---------------------------------------------------------------------------
# Clerk (authentication)
# ---------------------------------------------------------------------------
# Person 2 does NOT need these — schema work only.
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# ---------------------------------------------------------------------------
# Embedding model
# ---------------------------------------------------------------------------
# Match the dimension here to the vector(N) column in your schema.
# all-MiniLM-L6-v2 -> 384 dimensions
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
